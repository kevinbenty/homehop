# Copy to .env.local and fill in. Never commit real values.

# Flights. Ignav is used if set, then Duffel; with neither (or MOCK_FLIGHTS=1) the site shows demo fares.
# Ignav: self-serve key at https://ignav.com (1,000 free requests, then $2 per 1,000).
IGNAV_API_KEY=
# Pricing market (2-letter country code). Sets the currency Ignav returns.
IGNAV_MARKET=SE

# Test tokens start with duffel_test_ and return fake prices; live tokens start with duffel_live_.
DUFFEL_ACCESS_TOKEN=
MOCK_FLIGHTS=

# Postgres (Neon, Supabase, Vercel Postgres...). Needed for accounts and alerts.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Resend, for sign-in links and alert emails. https://resend.com
# Vercel's Resend integration sets RESEND_API_KEY instead; either works.
AUTH_RESEND_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend address.
EMAIL_FROM="HomeHop <onboarding@resend.dev>"

# Protects /api/cron/check-alerts. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Optional
APP_URL=
SEARCHES_PER_HOUR=20
ALERT_BATCH=10
